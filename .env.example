# Server
HOST_SERVER=localhost
PORT_SERVER=9000

# Swagger
HOST_SWAGG=localhost
PORT_SWAGG=9000

# POSTGRES CONNECTION
POSTGRES_USER={your_postgres_user}
POSTGRES_PASSWORD={your_postgres_password}
POSTGRES_DB={your_database_name}
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ORIGINS ALLOWED
ALLOWED_ORIGINS={your_ip_frontend_running}"

# JWT
JWT_SECREET_KEY={your_jwt_secret_key_here}
JWT_ISSUER={your_app_name_or_issuer}

# REDIS
REDIS_USER={your_redis_user}
REDIS_PASSWORD={your_redis_password}
REDIS_HOST=localhost
REDIS_PORT=6379